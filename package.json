{
  "name": "almoxarifado",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "test": "npm test -w backend",
    "test:integration": "npm run test:integration -w backend",
    "test:e2e": "node scripts/e2e.js",
    "format": "prettier --write backend/src backend/tests frontend/src frontend/tests *.js *.json docs README.md",
    "lint": "eslint .",
    "migrate": "npm run migrate -w backend",
    "bootstrap": "npm run bootstrap -w backend",
    "seed": "npm run seed -w backend",
    "bot": "npm run bot -w backend"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10"
  }
}
